RewriteOptions inherit
RewriteEngine On
RewriteCond %{HTTP_HOST} aic-techno\.com [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://aic-techno.com/$1 [R,L]
 
# Serve clean URLs without the .html extension (e.g. /back2bengal -> back2bengal.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)$ $1.html [L]